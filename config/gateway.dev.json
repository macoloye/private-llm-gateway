{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "tls": {
      "enabled": false,
      "cert_file": "certs/server.crt",
      "key_file": "certs/server.key",
      "client_ca_file": "certs/dev-ca.crt",
      "require_client_cert": false
    }
  },
  "auth": {
    "api_key_file": "config/api-keys.local.json",
    "admin_api_key_env": "GATEWAY_ADMIN_API_KEY",
    "jwt": {
      "enabled": false,
      "issuer": "https://issuer.example.invalid",
      "audience": "private-llm-gateway",
      "jwks_file": "config/jwks.local.json"
    },
    "oidc": {
      "enabled": false,
      "discovery_url": "https://issuer.example.invalid/.well-known/openid-configuration",
      "client_id": "private-llm-gateway"
    },
    "api_keys": [
      {
        "id": "team-a",
        "tenant": "team-a",
        "key_env": "TEAM_A_API_KEY",
        "allowed_models": ["qwen-local", "llama-local"]
      }
    ]
  },
  "routes": [
    {
      "name": "vllm-local",
      "backend": "http://vllm:8000",
      "tls_ca_file": "certs/dev-ca.crt",
      "tls_cert_file": "certs/client.crt",
      "tls_key_file": "certs/client.key",
      "local": true,
      "models": ["qwen-local"],
      "allowed_endpoints": [
        {"path": "/v1/chat/completions", "methods": ["POST"]},
        {"path": "/v1/completions", "methods": ["POST"]},
        {"path": "/v1/embeddings", "methods": ["POST"]},
        {"path": "/v1/models", "methods": ["GET"]}
      ]
    },
    {
      "name": "sglang-local",
      "backend": "http://sglang:30000",
      "tls_ca_file": "certs/dev-ca.crt",
      "tls_cert_file": "certs/client.crt",
      "tls_key_file": "certs/client.key",
      "local": true,
      "models": ["llama-local"],
      "allowed_endpoints": [
        {"path": "/v1/chat/completions", "methods": ["POST"]},
        {"path": "/v1/completions", "methods": ["POST"]},
        {"path": "/v1/embeddings", "methods": ["POST"]},
        {"path": "/v1/models", "methods": ["GET"]}
      ]
    }
  ],
  "privacy": {
    "access_log": "metadata",
    "redact_logs": true,
    "redact_before_forward": false,
    "audit_log_file": "logs/audit.log",
    "audit_retention_days": 30
  },
  "policy": {
    "default_privacy_class": "standard",
    "privacy_classes": [
      {"name": "standard"},
      {"name": "sensitive", "redact_before_forward": true},
      {"name": "restricted", "redact_before_forward": true}
    ],
    "tenants": [
      {
        "tenant": "team-a",
        "allowed_models": ["qwen-local", "llama-local"],
        "allowed_backends": ["vllm-local", "sglang-local"],
        "privacy_classes": ["standard", "sensitive", "restricted"]
      }
    ],
    "routing_rules": [
      {"tenant": "team-a", "model": "qwen-local", "privacy_class": "standard", "backend": "vllm-local"},
      {"tenant": "team-a", "model": "qwen-local", "privacy_class": "sensitive", "backend": "vllm-local"},
      {"tenant": "team-a", "model": "qwen-local", "privacy_class": "restricted", "backend": "vllm-local"},
      {"tenant": "team-a", "model": "llama-local", "privacy_class": "standard", "backend": "sglang-local"},
      {"tenant": "team-a", "model": "llama-local", "privacy_class": "sensitive", "backend": "sglang-local"},
      {"tenant": "team-a", "model": "llama-local", "privacy_class": "restricted", "backend": "sglang-local"}
    ]
  },
  "redaction": {
    "enabled": true,
    "rules": [
      {"name": "example_internal_ticket", "pattern": "TICKET-[0-9]+", "replacement": "[TICKET]"}
    ]
  },
  "logging": {
    "color": "always",
    "file": "logs/gateway.log"
  },
  "limits": {
    "max_request_body_bytes": 1048576,
    "max_output_tokens": 2048,
    "max_n": 4,
    "timeout_seconds": 120,
    "per_tenant_requests_per_minute": 120,
    "per_tenant_requests_per_day": 10000
  }
}
