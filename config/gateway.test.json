{
  "server": {
    "host": "127.0.0.1",
    "port": 0,
    "tls": {"enabled": false}
  },
  "auth": {
    "api_keys": [
      {
        "id": "test-key",
        "tenant": "test-tenant",
        "key": "test-secret",
        "allowed_models": ["test-model"]
      }
    ]
  },
  "routes": [
    {
      "name": "stub-backend",
      "backend": "http://127.0.0.1:1",
      "local": true,
      "models": ["test-model"],
      "allowed_endpoints": [
        {"path": "/v1/chat/completions", "methods": ["POST"]},
        {"path": "/v1/completions", "methods": ["POST"]},
        {"path": "/v1/embeddings", "methods": ["POST"]},
        {"path": "/v1/models", "methods": ["GET"]}
      ]
    }
  ],
  "privacy": {"access_log": "metadata", "audit_retention_days": 30},
  "policy": {
    "default_privacy_class": "standard",
    "tenants": [
      {
        "tenant": "test-tenant",
        "allowed_models": ["test-model"],
        "allowed_backends": ["stub-backend"],
        "privacy_classes": ["standard", "sensitive", "restricted"]
      }
    ],
    "routing_rules": [
      {"tenant": "test-tenant", "model": "test-model", "privacy_class": "standard", "backend": "stub-backend"},
      {"tenant": "test-tenant", "model": "test-model", "privacy_class": "sensitive", "backend": "stub-backend"},
      {"tenant": "test-tenant", "model": "test-model", "privacy_class": "restricted", "backend": "stub-backend"}
    ]
  },
  "logging": {"color": "never"},
  "limits": {
    "max_request_body_bytes": 1048576,
    "max_output_tokens": 2048,
    "max_n": 4,
    "timeout_seconds": 5
  }
}
